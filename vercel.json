{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/blueprint-content",
      "destination": "/blueprint-info",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blueprint",
      "destination": "/api/blueprint"
    },
    {
      "source": "/newsletter-:slug([a-z]+-[0-9]+-[0-9]+.*)",
      "destination": "/newsletter-detail"
    },
    {
      "source": "/article-:slug([a-z0-9].*)",
      "destination": "/article"
    },
    {
      "source": "/book-note-:slug([a-z0-9].*)",
      "destination": "/book-note"
    }
  ]
}
