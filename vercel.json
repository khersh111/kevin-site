{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/blueprint-content",
      "destination": "/blueprint-info",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/golf/thanks",
      "destination": "/golf-thanks"
    },
    {
      "source": "/golf/first-tee-warm-up.pdf",
      "destination": "/downloads/golfers-warm-up.pdf"
    },
    {
      "source": "/blueprint",
      "destination": "/api/blueprint"
    },
    {
      "source": "/newsletter-:slug([a-z]+-[0-9]+-[0-9]+.*)",
      "destination": "/newsletter-detail"
    },
    {
      "source": "/article-:slug([a-z0-9].*)",
      "destination": "/article"
    },
    {
      "source": "/book-note-:slug([a-z0-9].*)",
      "destination": "/book-note"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 14 * * *"
    }
  ]
}
